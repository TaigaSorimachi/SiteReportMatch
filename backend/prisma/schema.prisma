  postedBy  String  @map("posted_by") @db.Uuid

  siteName       String   @map("site_name") @db.VarChar(300)
  sitePrefecture String   @map("site_prefecture") @db.VarChar(10)
  siteCity       String   @map("site_city") @db.VarChar(50)
  siteAddress    String?  @map("site_address") @db.VarChar(300)
