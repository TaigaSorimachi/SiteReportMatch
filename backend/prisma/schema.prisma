  proposedRate   Int?       @map("proposed_rate")
  proposedPrice  BigInt?    @map("proposed_price")
  availableCount Int        @default(1) @map("available_count")
  availableDates DateTime[] @map("available_dates") @db.Date
  message        String?    @db.Text

  status          String    @default("pending") @db.VarChar(20)
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz()
  respondedBy     String?   @map("responded_by") @db.Uuid
