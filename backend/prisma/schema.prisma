// ##########################################################################
// H. マッチング共通 (3テーブル)
// ##########################################################################

/// H-01 成約
model MatchContract {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  demandPostingId String? @map("demand_posting_id") @db.Uuid
  demandAppId     String? @map("demand_app_id") @db.Uuid
  supplyPostingId String? @map("supply_posting_id") @db.Uuid
  supplyInquiryId String? @map("supply_inquiry_id") @db.Uuid

  clientCompanyId String  @map("client_company_id") @db.Uuid
  workerUserId    String  @map("worker_user_id") @db.Uuid
  workerCompanyId String? @map("worker_company_id") @db.Uuid
  projectId       String? @map("project_id") @db.Uuid

  contractType     String   @map("contract_type") @db.VarChar(20)
  agreedDailyRate  Int?     @map("agreed_daily_rate")
  agreedFixedPrice BigInt?  @map("agreed_fixed_price")
  workDateStart    DateTime @map("work_date_start") @db.Date
  workDateEnd      DateTime @map("work_date_end") @db.Date
