  responder      User?           @relation("ApplicationResponder", fields: [respondedBy], references: [id])
  messages       DemandMessage[]
  matchContracts MatchContract[] @relation("DemandAppContract")

  @@index([postingId, status])
  @@map("demand_applications")
}

