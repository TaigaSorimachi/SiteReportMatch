  contractTier       Int?      @map("contract_tier")
  workTimeStart      DateTime? @map("work_time_start") @db.Time()
  workTimeEnd        DateTime? @map("work_time_end") @db.Time()
  transportationType String?   @map("transportation_type") @db.VarChar(20)
  transportationNote String?   @map("transportation_note") @db.VarChar(200)
