  providesParking    Boolean   @default(false) @map("provides_parking")
  providesTools      Boolean   @default(false) @map("provides_tools")
  providesMeals      Boolean   @default(false) @map("provides_meals")
  description        String?   @db.Text
  notes              String?   @db.Text

  confirmedCount   Int       @default(0) @map("confirmed_count")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz()
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz()
  viewCount        Int       @default(0) @map("view_count")
  applicationCount Int       @default(0) @map("application_count")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid
