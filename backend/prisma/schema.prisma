  company        Company          @relation(fields: [companyId], references: [id])
  project        Project?         @relation(fields: [projectId], references: [id])
  poster         User             @relation(fields: [postedBy], references: [id])
  workType       WorkTypeMaster   @relation("DemandWorkType", fields: [workTypeId], references: [id])
  workTypeSub    WorkTypeMaster?  @relation("DemandWorkTypeSub", fields: [workTypeSubId], references: [id])
