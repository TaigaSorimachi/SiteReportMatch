  status           String    @default("active") @db.VarChar(20)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz()
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelReason     String?   @map("cancel_reason") @db.VarChar(300)

  matchedAt        DateTime  @default(now()) @map("matched_at") @db.Timestamptz()
  timeToMatchHours Decimal?  @map("time_to_match_hours") @db.Decimal(8, 1)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  demandPosting DemandPosting?     @relation("DemandContract", fields: [demandPostingId], references: [id])
  demandApp     DemandApplication? @relation("DemandAppContract", fields: [demandAppId], references: [id])
  supplyPosting SupplyPosting?     @relation("SupplyContract", fields: [supplyPostingId], references: [id])
  supplyInquiry SupplyInquiry?     @relation("SupplyInquiryContract", fields: [supplyInquiryId], references: [id])
  clientCompany Company            @relation("ClientContract", fields: [clientCompanyId], references: [id])
  workerUser    User               @relation(fields: [workerUserId], references: [id])
  workerCompany Company?           @relation("WorkerCompanyContract", fields: [workerCompanyId], references: [id])
  project       Project?           @relation(fields: [projectId], references: [id])
