  cancelLogs    MatchCancelLog[]
  assignments   ProjectAssignment[]

  @@map("match_contracts")
}

/// H-02 双方向レビュー
model MatchReview {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  reviewType String   @map("review_type") @db.VarChar(20)
  rating     Int?
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  contract MatchContract @relation(fields: [contractId], references: [id])
  reviewer User          @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  reviewee User          @relation("ReviewReviewee", fields: [revieweeId], references: [id])

  @@map("match_reviews")
}

/// H-03 キャンセルログ
model MatchCancelLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId      String?  @map("contract_id") @db.Uuid
  demandPostingId String?  @map("demand_posting_id") @db.Uuid
  supplyPostingId String?  @map("supply_posting_id") @db.Uuid
  cancelledBy     String   @map("cancelled_by") @db.Uuid
  cancelReason    String?  @map("cancel_reason") @db.VarChar(300)
  cancelType      String?  @map("cancel_type") @db.VarChar(20)
  penaltyAmount   Int      @default(0) @map("penalty_amount")
  cancelledAt     DateTime @default(now()) @map("cancelled_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  contract        MatchContract? @relation(fields: [contractId], references: [id])
  demandPosting   DemandPosting? @relation("DemandCancel", fields: [demandPostingId], references: [id])
  supplyPosting   SupplyPosting? @relation("SupplyCancel", fields: [supplyPostingId], references: [id])
  cancelledByUser User           @relation(fields: [cancelledBy], references: [id])

  @@map("match_cancel_logs")
}

// ##########################################################################
// I. カスタムフィールド (2テーブル)
// ##########################################################################

/// I-01 カスタム項目定義
model CustomFieldDef {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  targetType  String   @map("target_type") @db.VarChar(20)
  fieldLabel  String   @map("field_label") @db.VarChar(100)
  fieldKey    String   @map("field_key") @db.VarChar(50)
  inputType   String   @map("input_type") @db.VarChar(20)
  options     Json?    @db.JsonB
  isRequired  Boolean  @default(false) @map("is_required")
  isVisible   Boolean  @default(true) @map("is_visible")
  sortOrder   Int      @default(0) @map("sort_order")
  placeholder String?  @db.VarChar(200)
  helpText    String?  @map("help_text") @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company Company          @relation(fields: [companyId], references: [id])
  values  CustomFieldVal[]

  @@unique([companyId, targetType, fieldKey])
  @@map("custom_field_defs")
}

/// I-02 カスタム項目値
model CustomFieldVal {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldDefId String   @map("field_def_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.Uuid
  fieldValue String?  @map("field_value") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  fieldDef CustomFieldDef @relation(fields: [fieldDefId], references: [id])

  @@unique([fieldDefId, targetId])
  @@index([targetType, targetId])
  @@index([fieldDefId])
  @@map("custom_field_vals")
}

// ##########################################################################
// J. 会計・請求 (6テーブル)
// ##########################################################################

/// 勘定科目マスタ
model AccountMaster {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountCode     String   @unique @map("account_code") @db.VarChar(10)
  accountName     String   @map("account_name") @db.VarChar(100)
  accountType     String?  @map("account_type") @db.VarChar(30)
  parentCode      String?  @map("parent_code") @db.VarChar(10)
  isConstruction  Boolean  @default(true) @map("is_construction")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  invoiceLines      InvoiceLine[]
  costLedgerEntries CostLedger[]

  @@map("account_master")
}

/// J-01 請求書
model Invoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  clientCompanyId  String    @map("client_company_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  invoiceNumber    String    @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate      DateTime  @map("invoice_date") @db.Date
  dueDate          DateTime  @map("due_date") @db.Date
  billingType      String?   @map("billing_type") @db.VarChar(20)
  subtotal         BigInt
  taxAmount        BigInt    @map("tax_amount")
  totalAmount      BigInt    @map("total_amount")
  taxRate          Decimal   @default(10.00) @map("tax_rate") @db.Decimal(4, 2)
  qualifiedInvoice Boolean   @default(true) @map("qualified_invoice")
  invoiceRegNo     String?   @map("invoice_reg_no") @db.VarChar(20)
  status           String    @default("draft") @db.VarChar(20)
  issuedAt         DateTime? @map("issued_at") @db.Timestamptz()
  sentAt           DateTime? @map("sent_at") @db.Timestamptz()
  paidAt           DateTime? @map("paid_at") @db.Timestamptz()
  pdfUrl           String?   @map("pdf_url") @db.VarChar(500)
  notes            String?   @db.Text
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company       Company           @relation("InvoiceIssuer", fields: [companyId], references: [id])
  clientCompany Company           @relation("InvoiceClient", fields: [clientCompanyId], references: [id])
  project       Project?          @relation(fields: [projectId], references: [id])
  lines         InvoiceLine[]
  payments      PaymentReceived[]

  @@map("invoices")
}

/// J-02 請求明細
model InvoiceLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  lineOrder      Int      @default(0) @map("line_order")
  description    String   @db.VarChar(300)
  quantity       Decimal? @db.Decimal(10, 2)
  unit           String?  @db.VarChar(20)
  unitPrice      Decimal? @map("unit_price") @db.Decimal(12, 2)
  amount         BigInt
  taxCategory    String   @default("taxable") @map("tax_category") @db.VarChar(10)
  accountId      String?  @map("account_id") @db.Uuid
  projectPhaseId String?  @map("project_phase_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account      AccountMaster? @relation(fields: [accountId], references: [id])
  projectPhase ProjectPhase?  @relation(fields: [projectPhaseId], references: [id])

  @@map("invoice_lines")
}

/// J-03 入金記録
model PaymentReceived {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  paymentDate   DateTime @map("payment_date") @db.Date
  amount        BigInt
  paymentMethod String?  @map("payment_method") @db.VarChar(20)
  bankRef       String?  @map("bank_ref") @db.VarChar(100)
  notes         String?  @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments_received")
}

/// J-04 職人支払
model Payroll {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  workerId       String    @map("worker_id") @db.Uuid
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  paymentDate    DateTime? @map("payment_date") @db.Date
  grossAmount    BigInt    @map("gross_amount")
  withholdingTax BigInt    @default(0) @map("withholding_tax")
  deductions     BigInt    @default(0)
  netAmount      BigInt    @map("net_amount")
  status         String    @default("draft") @db.VarChar(20)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz()
  notes          String?   @db.Text
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company Company      @relation(fields: [companyId], references: [id])
  worker  User         @relation(fields: [workerId], references: [id])
  lines   PayrollLine[]

  @@map("payroll")
}

/// J-05 支払明細
model PayrollLine {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollId    String    @map("payroll_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  assignmentId String?   @map("assignment_id") @db.Uuid
  workDate     DateTime? @map("work_date") @db.Date
  manDays      Decimal?  @map("man_days") @db.Decimal(4, 2)
  dailyRate    Int?      @map("daily_rate")
  amount       BigInt
  description  String?   @db.VarChar(200)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  payroll    Payroll            @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  project    Project?           @relation(fields: [projectId], references: [id])
  assignment ProjectAssignment? @relation(fields: [assignmentId], references: [id])

  @@map("payroll_lines")
}

/// J-06 原価台帳
model CostLedger {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  accountId       String?  @map("account_id") @db.Uuid
  costCategory    String   @map("cost_category") @db.VarChar(30)
  transactionDate DateTime @map("transaction_date") @db.Date
  description     String?  @db.VarChar(300)
  amount          BigInt
  sourceType      String?  @map("source_type") @db.VarChar(20)
  sourceId        String?  @map("source_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  company Company        @relation(fields: [companyId], references: [id])
  project Project        @relation(fields: [projectId], references: [id])
  account AccountMaster? @relation(fields: [accountId], references: [id])

  @@index([projectId, costCategory])
  @@map("cost_ledger")
}

// ##########################################################################
// K. 通知ログ (1テーブル)
// ##########################################################################

/// K-01 通知ログ
model NotificationLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  channel          String    @db.VarChar(20)
  notificationType String    @map("notification_type") @db.VarChar(50)
  title            String?   @db.VarChar(200)
  body             String?   @db.Text
  relatedType      String?   @map("related_type") @db.VarChar(30)
  relatedId        String?   @map("related_id") @db.Uuid
  isRead           Boolean   @default(false) @map("is_read")
  sentAt           DateTime  @default(now()) @map("sent_at") @db.Timestamptz()
  readAt           DateTime? @map("read_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("notification_logs")
}
