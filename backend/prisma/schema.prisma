// ============================================================================
// 建築業界 人材マッチング管理システム — Prisma Schema
// 全42テーブル
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ##########################################################################
// A. 組織・ユーザー基盤 (5テーブル)
// ##########################################################################

/// A-01 会社マスタ — 自社/元請/協力会社/下請を統合管理
model Company {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName      String   @map("company_name") @db.VarChar(200)
  companyNameKana  String?  @map("company_name_kana") @db.VarChar(200)
  companyType      String   @map("company_type") @db.VarChar(30)
  corporateNumber  String?  @unique @map("corporate_number") @db.VarChar(13)
  representative   String?  @db.VarChar(100)
  postalCode       String?  @map("postal_code") @db.VarChar(8)
  address          String?  @db.VarChar(300)
  addressLat       Decimal? @map("address_lat") @db.Decimal(10, 7)
  addressLng       Decimal? @map("address_lng") @db.Decimal(10, 7)
  phone            String?  @db.VarChar(20)
  fax              String?  @db.VarChar(20)
  email            String?  @db.VarChar(200)
  website          String?  @db.VarChar(300)
  invoiceRegNo     String?  @map("invoice_reg_no") @db.VarChar(20)
  ccusCompanyId    String?  @map("ccus_company_id") @db.VarChar(30)

  bankName        String? @map("bank_name") @db.VarChar(100)
  bankBranch      String? @map("bank_branch") @db.VarChar(100)
  bankAccountType String? @map("bank_account_type") @db.VarChar(10)
  bankAccountNo   String? @map("bank_account_no") @db.VarChar(20)
  bankAccountName String? @map("bank_account_name") @db.VarChar(100)
  paymentTerms    String? @map("payment_terms") @db.VarChar(100)

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  settings          CompanySetting?
  users             User[]
  projects          Project[]       @relation("CompanyProjects")
  clientProjects    Project[]       @relation("ClientProjects")
  primeProjects     Project[]       @relation("PrimeProjects")
  demandPostings    DemandPosting[]
  supplyPostings    SupplyPosting[]
  customFieldDefs   CustomFieldDef[]
  invoicesIssued    Invoice[]       @relation("InvoiceIssuer")
  invoicesReceived  Invoice[]       @relation("InvoiceClient")
  payrolls          Payroll[]
  costLedgerEntries CostLedger[]
  dailyReports      DailyReport[]
  clientContracts   MatchContract[] @relation("ClientContract")
  workerContracts   MatchContract[] @relation("WorkerCompanyContract")

  @@map("companies")
}

/// A-02 会社別システム設定
model CompanySetting {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @unique @map("company_id") @db.Uuid

  defaultReportMode     String  @default("selectable") @map("default_report_mode") @db.VarChar(20)
  allowWorkerModeSwitch Boolean @default(true) @map("allow_worker_mode_switch")
  requirePhoto          Boolean @default(false) @map("require_photo")
  requireSafetyRecord   Boolean @default(false) @map("require_safety_record")

  gpsEnabled          Boolean @default(false) @map("gps_enabled")
  gpsWorkerCanDisable Boolean @default(false) @map("gps_worker_can_disable")
  geofenceEnabled     Boolean @default(false) @map("geofence_enabled")
  geofenceRadiusM     Int     @default(300) @map("geofence_radius_m")

  matchingEnabled     Boolean @default(true) @map("matching_enabled")
  matchingAutoApprove Boolean @default(false) @map("matching_auto_approve")

  standardWorkHours      Decimal @default(8.0) @map("standard_work_hours") @db.Decimal(3, 1)
  overtimeThresholdHours Decimal @default(8.0) @map("overtime_threshold_hours") @db.Decimal(3, 1)

  extra Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_settings")
}

/// A-03 ユーザー — admin(管理者)/owner(オーナー)/worker(作業者)の3ロール。LINE連携前提
model User {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String? @map("company_id") @db.Uuid

  lineUserId      String? @unique @map("line_user_id") @db.VarChar(50)
  lineDisplayName String? @map("line_display_name") @db.VarChar(100)

  lastName      String  @map("last_name") @db.VarChar(50)
  firstName     String  @map("first_name") @db.VarChar(50)
  lastNameKana  String? @map("last_name_kana") @db.VarChar(50)
  firstNameKana String? @map("first_name_kana") @db.VarChar(50)
  email         String? @db.VarChar(200)
  passwordHash  String? @map("password_hash") @db.VarChar(200)
  phone         String? @db.VarChar(20)
  birthDate     DateTime? @map("birth_date") @db.Date
  gender        String? @db.VarChar(10)
  avatarUrl     String? @map("avatar_url") @db.VarChar(500)

  postalCode String?  @map("postal_code") @db.VarChar(8)
  address    String?  @db.VarChar(300)
  addressLat Decimal? @map("address_lat") @db.Decimal(10, 7)
  addressLng Decimal? @map("address_lng") @db.Decimal(10, 7)

  role         String  @db.VarChar(30) /// admin/owner/worker
  isIndividual Boolean @default(false) @map("is_individual")

  defaultDailyRate  Int? @map("default_daily_rate")
  defaultHourlyRate Int? @map("default_hourly_rate")

  employmentStatus String @default("active") @map("employment_status") @db.VarChar(20)
  availability     String @default("available") @db.VarChar(20)

  ccusWorkerId String? @map("ccus_worker_id") @db.VarChar(30)

  taxCategory    String?  @map("tax_category") @db.VarChar(20)
  myNumberStored Boolean  @default(false) @map("my_number_stored")

  lineNotifyEnabled  Boolean @default(true) @map("line_notify_enabled")
  gpsPersonalEnabled Boolean @default(true) @map("gps_personal_enabled")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company              Company?              @relation(fields: [companyId], references: [id])
  workerProfile        WorkerProfile?
  userLicenses         UserLicense[]
  workerSkills         WorkerSkill[]
  workerAvailability   WorkerAvailability[]
  evaluationsReceived  WorkerEvaluation[]    @relation("EvaluationWorker")
  evaluationsGiven     WorkerEvaluation[]    @relation("EvaluationEvaluator")
  dailyReports         DailyReport[]         @relation("ReportWorker")
  approvedReports      DailyReport[]         @relation("ReportApprover")
  locationLogs         LocationLog[]
  geofenceEvents       GeofenceEvent[]
  demandApplications   DemandApplication[]   @relation("ApplicationApplicant")
  respondedApplications DemandApplication[]  @relation("ApplicationResponder")
  demandMessages       DemandMessage[]
  supplyPostings       SupplyPosting[]
  supplyInquiries      SupplyInquiry[]
  supplyMessages       SupplyMessage[]
  notificationLogs     NotificationLog[]
  projectAssignments   ProjectAssignment[]
  salesProjects        Project[]             @relation("SalesPerson")
  managedProjects      Project[]             @relation("SiteManager")
  foremanProjects      Project[]             @relation("Foreman")
  uploadedDocuments    ProjectDocument[]
  safetyRecords        SafetyRecord[]
  demandPostings       DemandPosting[]
  matchReviewsGiven    MatchReview[]         @relation("ReviewReviewer")
  matchReviewsReceived MatchReview[]         @relation("ReviewReviewee")
  matchCancelLogs      MatchCancelLog[]
  matchContractsWorker MatchContract[]
  payrolls             Payroll[]

  @@index([companyId])
  @@index([availability])
  @@index([lineUserId])
  @@map("users")
}

/// A-04 資格マスタ
model LicenseMaster {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  licenseName     String   @map("license_name") @db.VarChar(200)
  licenseCategory String?  @map("license_category") @db.VarChar(50)
  hasExpiry       Boolean  @default(false) @map("has_expiry")
  renewalMonths   Int?     @map("renewal_months")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userLicenses UserLicense[]

  @@map("license_master")
}

/// A-05 保有資格
model UserLicense {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  licenseId        String    @map("license_id") @db.Uuid
  licenseNumber    String?   @map("license_number") @db.VarChar(50)
  issuedDate       DateTime? @map("issued_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  issuingAuthority String?   @map("issuing_authority") @db.VarChar(200)
  documentUrl      String?   @map("document_url") @db.VarChar(500)
  isVerified       Boolean   @default(false) @map("is_verified")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  license LicenseMaster @relation(fields: [licenseId], references: [id])

  @@unique([userId, licenseId])
  @@map("user_licenses")
}

// ##########################################################################
// B. 人材管理 (4テーブル)
// ##########################################################################

/// B-01 職人プロフィール
model WorkerProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  experienceYears Int?    @map("experience_years")
  skillLevel      String? @map("skill_level") @db.VarChar(20)
  specialties     String? @db.Text
  careerSummary   String? @map("career_summary") @db.Text

  preferredArea  String?  @map("preferred_area") @db.VarChar(300)
  maxCommuteKm   Int      @default(50) @map("max_commute_km")
  hasVehicle     Boolean  @default(false) @map("has_vehicle")
  hasOwnTools    Boolean  @default(false) @map("has_own_tools")
  canDriveTruck  Boolean  @default(false) @map("can_drive_truck")
  availableHours String?  @map("available_hours") @db.VarChar(50)

  desiredDailyMin Int? @map("desired_daily_min")
  desiredDailyMax Int? @map("desired_daily_max")
  desiredMonthly  Int? @map("desired_monthly")

  totalProjects  Int     @default(0) @map("total_projects")
  totalWorkDays  Int     @default(0) @map("total_work_days")
  avgRating      Decimal @default(0.0) @map("avg_rating") @db.Decimal(2, 1)
  attendanceRate Decimal @default(100.0) @map("attendance_rate") @db.Decimal(4, 1)
  repeatRate     Decimal @default(0.0) @map("repeat_rate") @db.Decimal(4, 1)
  cancelCount    Int     @default(0) @map("cancel_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

/// B-02 工種マスタ — 大分類→小分類の2階層
model WorkTypeMaster {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  workTypeName String   @map("work_type_name") @db.VarChar(100)
  category     String?  @db.VarChar(50)
  level        Int      @default(1)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  parent              WorkTypeMaster?     @relation("WorkTypeHierarchy", fields: [parentId], references: [id])
  children            WorkTypeMaster[]    @relation("WorkTypeHierarchy")
  workerSkills        WorkerSkill[]
  projectPhases       ProjectPhase[]
  projectStaffing     ProjectStaffing[]
  projectAssignments  ProjectAssignment[]
  demandPostings      DemandPosting[]     @relation("DemandWorkType")
  demandPostingsSub   DemandPosting[]     @relation("DemandWorkTypeSub")
  supplyPostings      SupplyPosting[]     @relation("SupplyWorkType")
  supplyPostingsSub   SupplyPosting[]     @relation("SupplyWorkTypeSub")
  projects            Project[]

  @@map("work_type_master")
}

/// B-03 対応可能工種 — 職人×工種 N:M
model WorkerSkill {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  workTypeId      String   @map("work_type_id") @db.Uuid
  proficiency     String   @default("capable") @db.VarChar(20)
  yearsExperience Int?     @map("years_experience")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workType WorkTypeMaster @relation(fields: [workTypeId], references: [id])

  @@unique([userId, workTypeId])
  @@map("worker_skills")
}

/// B-04 現場評価 — 5軸
model WorkerEvaluation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId             String   @map("worker_id") @db.Uuid
  evaluatorId          String   @map("evaluator_id") @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  evaluationDate       DateTime @map("evaluation_date") @db.Date
  ratingSkill          Int?     @map("rating_skill")
  ratingSpeed          Int?     @map("rating_speed")
  ratingAttitude       Int?     @map("rating_attitude")
  ratingSafety         Int?     @map("rating_safety")
  ratingCommunication  Int?     @map("rating_communication")
  ratingOverall        Decimal? @map("rating_overall") @db.Decimal(2, 1)
  comment              String?  @db.Text
  isPublic             Boolean  @default(false) @map("is_public")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  worker    User    @relation("EvaluationWorker", fields: [workerId], references: [id])
  evaluator User    @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@map("worker_evaluations")
}

/// B-05 稼働カレンダー — 日別空き状況
model WorkerAvailability {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetDate DateTime @map("target_date") @db.Date
  status     String   @default("available") @db.VarChar(20)
  projectId  String?  @map("project_id") @db.Uuid
  notes      String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([userId, targetDate])
  @@index([targetDate, status])
  @@map("worker_availability")
}

// ##########################################################################
// C. 案件管理 (5テーブル)
// ##########################################################################

/// 構造マスタ
model StructureMaster {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  structureName String   @map("structure_name") @db.VarChar(50)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  projects       Project[]
  demandPostings DemandPosting[]

  @@map("structure_master")
}

/// C-01 案件マスタ
model Project {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  projectCode String? @unique @map("project_code") @db.VarChar(50)

  projectName String  @map("project_name") @db.VarChar(300)
  description String? @db.Text

  clientCompanyId   String? @map("client_company_id") @db.Uuid
  primeContractorId String? @map("prime_contractor_id") @db.Uuid
  contractTier      Int     @default(1) @map("contract_tier")

  primaryWorkTypeId String? @map("primary_work_type_id") @db.Uuid

  structureId  String? @map("structure_id") @db.Uuid
  floorCount   Int?    @map("floor_count")
  propertyType String? @map("property_type") @db.VarChar(50)

  siteName       String?  @map("site_name") @db.VarChar(200)
  sitePostalCode String?  @map("site_postal_code") @db.VarChar(8)
  sitePrefecture String?  @map("site_prefecture") @db.VarChar(10)
  siteCity       String?  @map("site_city") @db.VarChar(50)
  siteAddress    String?  @map("site_address") @db.VarChar(300)
  siteLat        Decimal? @map("site_lat") @db.Decimal(10, 7)
  siteLng        Decimal? @map("site_lng") @db.Decimal(10, 7)
  geofenceRadiusM Int     @default(300) @map("geofence_radius_m")

  scheduledStart DateTime? @map("scheduled_start") @db.Date
  scheduledEnd   DateTime? @map("scheduled_end") @db.Date
  actualStart    DateTime? @map("actual_start") @db.Date
  actualEnd      DateTime? @map("actual_end") @db.Date

  contractAmount BigInt?  @map("contract_amount")
  estimatedCost  BigInt?  @map("estimated_cost")
  taxRate        Decimal  @default(10.00) @map("tax_rate") @db.Decimal(4, 2)

  safetyDocSystem String?  @map("safety_doc_system") @db.VarChar(100)
  ccusRequired    Boolean  @default(false) @map("ccus_required")

  salesPersonId  String? @map("sales_person_id") @db.Uuid
  siteManagerId  String? @map("site_manager_id") @db.Uuid
  foremanId      String? @map("foreman_id") @db.Uuid

  status String @default("planning") @db.VarChar(20)

  notes     String?   @db.Text
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  company            Company              @relation("CompanyProjects", fields: [companyId], references: [id])
  clientCompany      Company?             @relation("ClientProjects", fields: [clientCompanyId], references: [id])
  primeContractor    Company?             @relation("PrimeProjects", fields: [primeContractorId], references: [id])
  primaryWorkType    WorkTypeMaster?      @relation(fields: [primaryWorkTypeId], references: [id])
  structure          StructureMaster?     @relation(fields: [structureId], references: [id])
  salesPerson        User?                @relation("SalesPerson", fields: [salesPersonId], references: [id])
  siteManager        User?                @relation("SiteManager", fields: [siteManagerId], references: [id])
  foreman            User?                @relation("Foreman", fields: [foremanId], references: [id])
  phases             ProjectPhase[]
  staffing           ProjectStaffing[]
  assignments        ProjectAssignment[]
  documents          ProjectDocument[]
  dailyReports       DailyReport[]
  safetyRecords      SafetyRecord[]
  demandPostings     DemandPosting[]
  invoices           Invoice[]
  costLedgerEntries  CostLedger[]
  workerEvaluations  WorkerEvaluation[]
  workerAvailability WorkerAvailability[]
  locationLogs       LocationLog[]
  geofenceEvents     GeofenceEvent[]
  supplyInquiries    SupplyInquiry[]
  matchContracts     MatchContract[]
  payrollLines       PayrollLine[]

  @@index([status])
  @@index([scheduledStart, scheduledEnd])
  @@map("projects")
}

/// C-02 工程（フェーズ）
model ProjectPhase {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  phaseName      String    @map("phase_name") @db.VarChar(200)
  workTypeId     String?   @map("work_type_id") @db.Uuid
  sortOrder      Int       @default(0) @map("sort_order")
  scheduledStart DateTime? @map("scheduled_start") @db.Date
  scheduledEnd   DateTime? @map("scheduled_end") @db.Date
  actualStart    DateTime? @map("actual_start") @db.Date
  actualEnd      DateTime? @map("actual_end") @db.Date
  progressPct    Decimal   @default(0.00) @map("progress_pct") @db.Decimal(5, 2)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workType     WorkTypeMaster? @relation(fields: [workTypeId], references: [id])
  invoiceLines InvoiceLine[]

  @@map("project_phases")
}

/// C-03 人員計画（工種×日）
model ProjectStaffing {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  workTypeId     String?  @map("work_type_id") @db.Uuid
  targetDate     DateTime @map("target_date") @db.Date
  requiredCount  Int      @default(1) @map("required_count")
  confirmedCount Int      @default(0) @map("confirmed_count")
  notes          String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workType WorkTypeMaster? @relation(fields: [workTypeId], references: [id])

  @@unique([projectId, workTypeId, targetDate])
  @@map("project_staffing")
}

/// C-04 配置確定
model ProjectAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  targetDate      DateTime  @map("target_date") @db.Date
  workTypeId      String?   @map("work_type_id") @db.Uuid
  contractType    String    @map("contract_type") @db.VarChar(20)
  dailyRate       Int?      @map("daily_rate")
  hourlyRate      Int?      @map("hourly_rate")
  source          String    @default("direct") @db.VarChar(20)
  demandPostingId String?   @map("demand_posting_id") @db.Uuid
  supplyPostingId String?   @map("supply_posting_id") @db.Uuid
  contractId      String?   @map("contract_id") @db.Uuid
  status          String    @default("confirmed") @db.VarChar(20)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelReason    String?   @map("cancel_reason") @db.VarChar(200)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  project       Project        @relation(fields: [projectId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
